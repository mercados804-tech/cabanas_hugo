# ==========================================================
# Variables de entorno - Sistema de Gestión de Reservas
# Cabañas Puerto Iguazú (Ejército Argentino)
# ==========================================================
# Copiar este archivo como ".env" y completar con los datos
# del proyecto de Supabase (Configuración > API).
#
# IMPORTANTE:
#   - Solo se utiliza la clave pública "anon". Vite expone las
#     variables VITE_* en el frontend, por eso NUNCA se debe
#     colocar aquí la clave "service_role".
#   - La seguridad real de los datos se garantiza con las
#     políticas RLS configuradas en Supabase (Etapa 2).
# ==========================================================

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_clave_publica_anon

# ----------------------------------------------------------
# OPCIONAL - Alias de acceso del administrador
# ----------------------------------------------------------
# Si se completa, se podrá iniciar sesión escribiendo un nombre
# de usuario simple en lugar del correo completo. Debe coincidir
# con el correo de la cuenta administradora creada en Supabase.
# Ejemplo: VITE_ADMIN_EMAIL=admin@cabanasiguazu.mil.ar
VITE_ADMIN_EMAIL=
